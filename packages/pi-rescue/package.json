{
	"name": "@howaboua/pi-rescue",
	"version": "0.0.1",
	"description": "Compact Pi sessions with a small, configurable model and a tool-free summary pass.",
	"type": "module",
	"main": "index.ts",
	"exports": "./index.ts",
	"license": "MIT",
	"files": [
		"index.ts",
		"src",
		"CHANGELOG.md",
		"README.md",
		"LICENSE",
		"tsconfig.json",
		"biome.json"
	],
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-coding-agent",
		"compaction",
		"context"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
		"directory": "packages/pi-rescue"
	},
	"homepage": "https://github.com/IgorWarzocha/howaboua-pi-stuff/tree/main/packages/pi-rescue#readme",
	"bugs": {
		"url": "https://github.com/IgorWarzocha/howaboua-pi-stuff/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=0.81.0",
		"@earendil-works/pi-coding-agent": ">=0.81.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@earendil-works/pi-ai": "0.81.0",
		"@earendil-works/pi-coding-agent": "0.81.0",
		"@types/node": "^24.10.0",
		"typescript": "^6.0.3"
	},
	"scripts": {
		"check": "bun run lint && bun run typecheck && bun run test",
		"prepack": "bun run check",
		"test": "bun test",
		"typecheck": "tsgo --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"pack:dry": "npm pack --dry-run"
	}
}
