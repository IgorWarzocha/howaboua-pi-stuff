{
	"name": "@howaboua/pi-shepherdr",
	"version": "0.1.2",
	"description": "Persistent blocking and asynchronous Pi agents through Herdr.",
	"type": "module",
	"license": "MIT",
	"author": "Igor Warzocha",
	"homepage": "https://github.com/IgorWarzocha/howaboua-pi-stuff/tree/main/packages/pi-shepherdr#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
		"directory": "packages/pi-shepherdr"
	},
	"bugs": {
		"url": "https://github.com/IgorWarzocha/howaboua-pi-stuff/issues"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"herdr",
		"shepherdr",
		"agents",
		"orchestration"
	],
	"files": [
		"index.ts",
		"src",
		"profiles",
		"README.md",
		"LICENSE",
		"tsconfig.json",
		"biome.json",
		"changelog.ts",
		"CHANGELOG.md"
	],
	"scripts": {
		"check": "bun run lint && bun run typecheck",
		"prepack": "bun run check",
		"typecheck": "tsgo --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"pack:dry": "npm pack --dry-run"
	},
	"peerDependencies": {
		"@howaboua/pi-codex-conversion": ">=3.0.24",
		"@earendil-works/pi-ai": ">=0.84.3",
		"@earendil-works/pi-coding-agent": ">=0.84.3",
		"@earendil-works/pi-tui": ">=0.84.3",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@howaboua/pi-codex-conversion": {
			"optional": true
		}
	},
	"devDependencies": {
		"@howaboua/pi-codex-conversion": "3.0.23",
		"@biomejs/biome": "^2.5.10",
		"@earendil-works/pi-ai": "0.84.4",
		"@earendil-works/pi-coding-agent": "0.84.4",
		"@earendil-works/pi-tui": "0.84.4",
		"@types/node": "^26.2.0",
		"typebox": "1.3.18",
		"typescript": "^7.0.2"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"engines": {
		"node": ">=20.6.0"
	},
	"main": "index.ts",
	"exports": "./index.ts",
	"publishConfig": {
		"access": "public"
	}
}
