{
	"name": "@howaboua/pi-grok-realtime",
	"version": "0.0.4",
	"description": "Grok realtime voice with Pi as the working agent, locally and over LAN",
	"license": "MIT",
	"type": "module",
	"main": "./index.ts",
	"exports": {
		".": "./index.ts",
		"./tools": "./tools.ts"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"index.ts",
		"tools.ts",
		"examples",
		"docs",
		"src",
		"scripts",
		"README.md",
		"LICENSE",
		"tsconfig.json",
		"biome.json",
		"!src/**/AGENTS.md",
		"!src/audio/rust/target",
		"changelog.ts",
		"CHANGELOG.md"
	],
	"pi": {
		"extensions": [
			"./changelog.ts",
			"./index.ts"
		]
	},
	"scripts": {
		"check": "bun run lint && bun run typecheck",
		"lint": "biome check .",
		"typecheck": "tsgo --noEmit",
		"build:audio-helper": "node scripts/build-audio-helper.mjs",
		"pack:dry": "npm pack --dry-run"
	},
	"dependencies": {
		"@howaboua/pi-browser": "^0.0.13",
		"selfsigned": "^5.5.0",
		"ws": "^8.22.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.0.0",
		"@earendil-works/pi-ai": ">=1.0.0",
		"@earendil-works/pi-tui": ">=1.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"@types/node": "^26.6.5",
		"@types/ws": "^8.18.2",
		"typescript": "^7.0.2"
	}
}
