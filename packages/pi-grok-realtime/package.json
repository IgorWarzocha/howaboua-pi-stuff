{
  "name": "@howaboua/pi-grok-realtime",
  "version": "0.0.8",
  "description": "Grok realtime voice with Pi as the working agent, locally and over LAN",
  "license": "MIT",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./tools": "./tools.ts",
    "./host-settings": "./dist/host-settings.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.ts",
    "tools.ts",
    "examples",
    "docs",
    "src",
    "scripts",
    "README.md",
    "LICENSE",
    "tsconfig.json",
    "!src/**/AGENTS.md",
    "!src/audio/rust/target",
    "CHANGELOG.md",
    "dist/host-settings.js"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck",
    "lint": "bun run format:check && oxlint --type-aware",
    "typecheck": "tsrs --noEmit",
    "build:audio-helper": "node scripts/build-audio-helper.mjs",
    "pack:dry": "npm pack --dry-run",
    "build:host-settings": "bun build ./src/host-settings.ts --target=node --outfile=./dist/host-settings.js",
    "prepack": "bun run check && bun run build:host-settings",
    "prepare": "bun run build:host-settings",
    "format:check": "oxfmt --check '**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,css}'"
  },
  "dependencies": {
    "@howaboua/pi-browser": "0.0.15",
    "selfsigned": "5.5.0",
    "ws": "8.23.0",
    "@earendil-works/pi-schema": "1.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-ai": ">=1.0.0",
    "@earendil-works/pi-tui": ">=1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "oxfmt": "0.79.0"
  }
}
