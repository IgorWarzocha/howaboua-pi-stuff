#!/bin/sh
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT_DIR=$(dirname -- "$SCRIPT_DIR")
PLATFORM=$(node -e 'process.stdout.write(process.platform)')
ARCH=$(node -e 'process.stdout.write(process.arch)')
EXE=imagegen
if [ "$PLATFORM" = "win32" ]; then EXE=imagegen.exe; fi
BINARY="$ROOT_DIR/vendor/path-tools/$PLATFORM-$ARCH/$EXE"
if [ ! -f "$BINARY" ]; then
  echo "image_gen.imagegen binary is not bundled for $PLATFORM-$ARCH." >&2
  echo "Expected bundled binaries under vendor/path-tools/<platform>-<arch>/." >&2
  exit 127
fi
chmod +x "$BINARY" 2>/dev/null || true
exec "$BINARY" "$@"
