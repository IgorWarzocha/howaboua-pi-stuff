{
  "name": "@howaboua/pi-codex-conversion",
  "version": "3.0.24",
  "description": "Codex-oriented tool and prompt adapter for pi coding agent",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
    "directory": "packages/pi-codex-conversion"
  },
  "homepage": "https://github.com/IgorWarzocha/howaboua-pi-stuff/tree/main/packages/pi-codex-conversion#readme",
  "bugs": {
    "url": "https://github.com/IgorWarzocha/howaboua-pi-stuff/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "codex",
    "adapter",
    "apply-patch"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./code-mode-preflight": {
      "types": "./dist/code-mode-preflight.d.ts",
      "import": "./dist/code-mode-preflight.js"
    },
    "./code-mode": {
      "types": "./dist/code-mode.d.ts",
      "import": "./dist/code-mode.js"
    },
    "./apply-patch-display": {
      "types": "./dist/apply-patch-display.d.ts",
      "import": "./dist/apply-patch-display.js"
    },
    "./realtime-voice": {
      "types": "./dist/realtime-voice.d.ts",
      "import": "./dist/realtime-voice.js"
    },
    "./*": "./*"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.md",
    "types/**/*.d.ts",
    "src/voice/lan/assets/**",
    "examples/code-mode-extension",
    "examples/custom-tools",
    "CHANGELOG.md",
    "README.md",
    "UPSTREAM_SYNC.md",
    "LICENSE",
    "src/tools/**/bin/**",
    "src/voice/bin/**",
    "code-mode/UPSTREAM_SYNC.md",
    "code-mode/vendor/code-mode-src/LICENSE",
    "code-mode/vendor/code-mode-src/NOTICE",
    "code-mode/vendor/code-mode-src/UPSTREAM",
    "scripts/code-mode",
    "!src/**/AGENTS.md",
    "!src/tools/target/**",
    "changelog.ts",
    "changelog.js"
  ],
  "scripts": {
    "build": "node -e \"const fs=require('node:fs'); fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('changelog.js', { force: true })\" && tsc -p tsconfig.build.json && node ../../scripts/build-extension-changelog.mjs .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test tests/**/*.test.ts examples/custom-tools/browser/*.test.mjs",
    "check": "node ../../scripts/sync-browser-cdp.mjs --check && bun run typecheck && bun run test",
    "publish:dry-run": "npm publish --dry-run",
    "publish:dev": "npm publish --tag dev",
    "release:dev": "npm version prerelease --preid dev && npm publish --tag dev",
    "prepack": "bun run check && bun run build",
    "prepare": "bun run build",
    "prepublishOnly": "bun run verify:extension-artifact && bun run verify:codex-tool-binaries && bun run verify:code-mode-host-assets",
    "verify:extension-artifact": "node ../../scripts/verify-pi-extension-artifact.mjs --no-build packages/pi-codex-conversion",
    "build:apply-patch": "node scripts/build-apply-patch-binary.mjs",
    "sync:apply-patch-source": "node scripts/sync-apply-patch-source.mjs",
    "verify:codex-tool-binaries": "node scripts/verify-codex-tool-binaries.mjs",
    "build:changed-native-tools": "node scripts/build-changed-native-tool-binaries.mjs",
    "build:native-tool": "node scripts/build-native-tool-binary.mjs",
    "build:code-mode-host": "node scripts/code-mode/build-host.mjs",
    "build:voice-helper": "node scripts/build-voice-helper.mjs",
    "verify:code-mode-host-assets": "node scripts/code-mode/verify-host-assets.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.3",
    "@earendil-works/pi-coding-agent": ">=0.84.4",
    "@earendil-works/pi-tui": ">=0.84.3",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typebox": "1.3.18",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.21",
    "openai": "7.5.0",
    "partial-json": "^0.1.7",
    "proxy-from-env": "2.1.0",
    "selfsigned": "^5.5.0",
    "smol-toml": "^1.8.0",
    "tree-sitter-bash": "^0.25.1",
    "undici": "8.10.0",
    "unzipper": "0.12.5",
    "web-tree-sitter": "^0.26.13",
    "ws": "^8.21.3",
    "zeromq": "6.6.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
