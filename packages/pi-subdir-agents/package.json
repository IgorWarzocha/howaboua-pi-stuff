{
  "name": "@howaboua/pi-subdir-agents",
  "version": "0.0.10",
  "description": "Pi extension that loads nested AGENTS.md context during repository discovery",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
    "directory": "packages/pi-subdir-agents"
  },
  "bugs": {
    "url": "https://github.com/IgorWarzocha/howaboua-pi-stuff/issues"
  },
  "homepage": "https://github.com/IgorWarzocha/howaboua-pi-stuff/tree/main/packages/pi-subdir-agents#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "agents",
    "context"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "tsconfig.json",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": ">=1.0.0",
    "@howaboua/pi-codex-conversion": ">=5.1.0"
  },
  "peerDependenciesMeta": {
    "@howaboua/pi-codex-conversion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@howaboua/pi-codex-conversion": "5.1.0",
    "typescript": "7.0.2",
    "oxfmt": "0.79.0"
  },
  "scripts": {
    "lint": "bun run format:check && oxlint --type-aware",
    "typecheck": "tsrs --noEmit",
    "check": "bun run lint && bun run typecheck",
    "pack:dry": "npm pack --dry-run",
    "format:check": "oxfmt --check '**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,css}'"
  },
  "main": "index.ts",
  "exports": "./index.ts"
}
