{
	"name": "@howaboua/pi-browser",
	"version": "0.0.0",
	"description": "Logged-in browser inspection and control for Pi, Code Mode and Notebook Mode.",
	"type": "module",
	"license": "MIT",
	"author": "Igor Warzocha",
	"homepage": "https://github.com/IgorWarzocha/howaboua-pi-stuff/tree/main/packages/pi-browser#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
		"directory": "packages/pi-browser"
	},
	"bugs": {
		"url": "https://github.com/IgorWarzocha/howaboua-pi-stuff/issues"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"browser",
		"chrome",
		"cdp",
		"code-mode"
	],
	"files": [
		"index.ts",
		"src",
		"browser",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"tsconfig.json",
		"biome.json"
	],
	"scripts": {
		"check": "node ../../scripts/sync-browser-cdp.mjs --check && bun run lint && bun run typecheck && bun run test",
		"prepack": "bun run check",
		"typecheck": "tsgo --noEmit",
		"lint": "biome check index.ts src package.json tsconfig.json biome.json",
		"test": "node --test tests/*.test.mjs",
		"pack:dry": "npm pack --dry-run"
	},
	"peerDependencies": {
		"@howaboua/pi-codex-conversion": ">=3.0.24",
		"@earendil-works/pi-ai": ">=0.84.3",
		"@earendil-works/pi-coding-agent": ">=0.84.3",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@howaboua/pi-codex-conversion": {
			"optional": true
		}
	},
	"devDependencies": {
		"@howaboua/pi-codex-conversion": "3.0.23",
		"@biomejs/biome": "^2.5.10",
		"@earendil-works/pi-ai": "0.84.3",
		"@earendil-works/pi-coding-agent": "0.84.3",
		"@types/node": "^26.2.0",
		"typebox": "1.3.18",
		"typescript": "^7.0.2"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "index.ts",
	"exports": "./index.ts",
	"publishConfig": {
		"access": "public"
	}
}
