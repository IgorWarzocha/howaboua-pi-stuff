{
	"name": "@howaboua/pi-sandbox",
	"private": true,
	"version": "0.1.0",
	"description": "Persistent local Gondolin environments and managed app previews for Pi",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
		"directory": "packages/pi-sandbox"
	},
	"files": [
		"index.ts",
		"src",
		"README.md",
		"LICENSE"
	],
	"main": "index.ts",
	"exports": "./index.ts",
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"dependencies": {
		"@earendil-works/gondolin": "0.13.0",
		"yaml": "2.9.1",
		"zod": "4.4.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.0.4",
		"typebox": "*",
		"@howaboua/pi-codex-conversion": ">=3.0.49"
	},
	"peerDependenciesMeta": {
		"@howaboua/pi-codex-conversion": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.1.0",
		"@howaboua/pi-codex-conversion": "3.0.49",
		"typebox": "1.3.18",
		"@types/node": "^26.2.0",
		"@biomejs/biome": "^2.5.10",
		"typescript": "^7.0.2"
	},
	"scripts": {
		"check": "bun run lint && bun run typecheck",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsgo --noEmit",
		"prepack": "bun run check",
		"pack:dry": "npm pack --dry-run"
	}
}
