{
	"name": "@howaboua/pi-chatgpt-sites",
	"version": "0.0.1",
	"description": "ChatGPT Sites management for Pi, Code Mode and Notebook",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
		"directory": "packages/pi-chatgpt-sites"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"changelog.ts",
		"CHANGELOG.md"
	],
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"pi": {
		"extensions": [
			"./changelog.ts",
			"./dist/index.js"
		]
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"check": "bun run lint && bun run typecheck",
		"lint": "biome check .",
		"typecheck": "tsgo --noEmit",
		"prepack": "bun run check && bun run build",
		"pack:dry": "npm pack --dry-run"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.1.0",
		"typebox": "*",
		"@earendil-works/pi-tui": ">=1.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
