{
  "name": "@howaboua/pi-pet",
  "version": "0.1.3",
  "description": "Animated companions for GipPity Remote.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
    "directory": "packages/pi-pet"
  },
  "homepage": "https://github.com/IgorWarzocha/howaboua-pi-stuff/tree/main/packages/pi-pet#readme",
  "bugs": {
    "url": "https://github.com/IgorWarzocha/howaboua-pi-stuff/issues"
  },
  "type": "module",
  "main": "./extensions/index.ts",
  "exports": "./extensions/index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pet"
  ],
  "files": [
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "deploy",
    "desktop/build.mjs",
    "desktop/package-lock.json",
    "desktop/package.json",
    "dist",
    "docs",
    "extensions",
    "pets",
    "authoring",
    "src/desktop",
    "src/pet-image-size.ts",
    "src/pet-loader.ts",
    "src/pet-storage.ts",
    "src/protocol/index.ts",
    "!**/AGENTS.md",
    "!**/__pycache__",
    "!**/*.pyc",
    "!**/.venv",
    "!authoring/hatch/tests",
    "changelog.ts",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "desktop:start": "npm --prefix desktop run build && npm --prefix desktop start",
    "pet:hatch:test": "uv run --isolated --project authoring/hatch --locked python -m unittest discover -s authoring/hatch/tests -p 'test_*.py' -v",
    "pet:prepare": "node dist/authoring/prepare.mjs",
    "pet:rebuild": "node dist/authoring/rebuild.mjs",
    "pet:validate": "node dist/authoring/validate.mjs",
    "typecheck": "tsgo --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:strict": "biome check --error-on-warnings .",
    "knip": "knip",
    "deadcode": "knip",
    "ai:check": "biome check . && tsgo --noEmit --noCheck && knip && bun run test && bun run build",
    "ai:check:strict": "biome check --error-on-warnings . && tsgo --noEmit && knip && bun run test && bun run build",
    "check": "bun run ai:check:strict",
    "prepack": "bun run check",
    "pack:dry": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.0",
  "peerDependencies": {
    "@howaboua/pi-gippity-control": ">=0.0.17",
    "@earendil-works/pi-coding-agent": ">=0.84.3",
    "@earendil-works/pi-tui": ">=0.84.3",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@howaboua/pi-gippity-control": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^26.2.0",
    "electron": "43.4.1",
    "knip": "^6.32.2",
    "typebox": "1.3.18",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
