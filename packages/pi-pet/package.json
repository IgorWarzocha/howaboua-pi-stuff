{
  "name": "@howaboua/pi-pet",
  "version": "0.1.10",
  "description": "Animated companions for GipPity Remote.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
    "directory": "packages/pi-pet"
  },
  "homepage": "https://github.com/IgorWarzocha/howaboua-pi-stuff/tree/main/packages/pi-pet#readme",
  "bugs": {
    "url": "https://github.com/IgorWarzocha/howaboua-pi-stuff/issues"
  },
  "type": "module",
  "main": "./extensions/index.ts",
  "exports": "./extensions/index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pet"
  ],
  "files": [
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "deploy",
    "desktop/build.mjs",
    "desktop/package-lock.json",
    "desktop/package.json",
    "dist",
    "docs",
    "extensions",
    "pets",
    "authoring",
    "src/desktop",
    "src/pet-image-size.ts",
    "src/pet-loader.ts",
    "src/pet-storage.ts",
    "src/protocol/index.ts",
    "!**/AGENTS.md",
    "!**/__pycache__",
    "!**/*.pyc",
    "!**/.venv",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "desktop:start": "npm --prefix desktop run build && npm --prefix desktop start",
    "pet:prepare": "node dist/authoring/prepare.mjs",
    "pet:rebuild": "node dist/authoring/rebuild.mjs",
    "pet:validate": "node dist/authoring/validate.mjs",
    "typecheck": "tsrs --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "lint": "bun run format:check && oxlint --type-aware && bun run lint:html && bun run lint:css",
    "lint:fix": "oxfmt --write '**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,css}' && oxlint --type-aware --fix",
    "lint:strict": "bun run lint",
    "knip": "knip",
    "deadcode": "knip",
    "ai:check": "bun run lint && tsrs --noEmit --noCheck && knip && bun run test && bun run build",
    "ai:check:strict": "bun run lint:strict && bun run typecheck && knip && bun run test && bun run build",
    "check": "bun run ai:check:strict",
    "prepack": "bun run check",
    "pack:dry": "npm pack --dry-run",
    "format:check": "oxfmt --check '**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,css}'",
    "lint:html": "html-validate 'src/**/*.html' --max-warnings 0",
    "lint:css": "stylelint 'src/**/*.css' --max-warnings 0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.2",
  "peerDependencies": {
    "@howaboua/pi-gippity-control": ">=0.0.34",
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": ">=1.0.0",
    "@howaboua/pi-codex-conversion": ">=5.1.0"
  },
  "peerDependenciesMeta": {
    "@howaboua/pi-gippity-control": {
      "optional": true
    },
    "@howaboua/pi-codex-conversion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@types/node": "^26.6.6",
    "electron": "44.10.2",
    "knip": "^6.45.0",
    "typescript": "^7.0.2",
    "@howaboua/pi-codex-conversion": "5.1.0",
    "oxfmt": "^0.78.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "oxlint": "1.94.0",
    "html-validate": "11.4.0",
    "stylelint": "17.16.0",
    "aria-query": "5.3.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@earendil-works/pi-schema": "1.6.0"
  }
}
