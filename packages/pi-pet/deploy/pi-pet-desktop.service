[Unit]
Description=Pi Pet transparent desktop companion
Wants=network-online.target
After=graphical-session.target network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
PassEnvironment=DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR HYPRLAND_INSTANCE_SIGNATURE
WorkingDirectory=%h/.local/share/pi-pet-desktop
ExecStart=%h/.local/share/pi-pet-desktop/runtime/electron %h/.local/share/pi-pet-desktop/app
KillMode=mixed
TimeoutStopSec=5
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=graphical-session.target
