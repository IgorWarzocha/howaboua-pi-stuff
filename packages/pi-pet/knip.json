{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "extensions/index.ts",
    "src/desktop/main.ts",
    "src/desktop/preload.ts",
    "src/web/main.ts",
    "tests/*.test.ts"
  ],
  "project": ["extensions/**/*.ts", "src/**/*.ts", "tests/**/*.ts"],
  "ignoreBinaries": ["uv"],
  "ignoreIssues": {
    "src/protocol/index.ts": ["exports", "types"]
  }
}
