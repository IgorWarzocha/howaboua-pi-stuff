{
  "name": "@howaboua/pi-unicode-charts",
  "version": "0.1.6",
  "description": "Terminal-native Unicode charts for Pi Markdown",
  "type": "module",
  "main": "src/index.ts",
  "exports": "./src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "tsconfig.json",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck",
    "prepack": "bun run check",
    "typecheck": "tsrs --noEmit",
    "lint": "bun run format:check && oxlint --type-aware",
    "format": "oxfmt --write '**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,css}'",
    "format:check": "oxfmt --check '**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,css}'"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi",
    "unicode",
    "charts",
    "terminal",
    "markdown",
    "sparkline",
    "heatmap",
    "data-visualization"
  ],
  "author": "howaboua",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
    "directory": "packages/pi-unicode-charts"
  },
  "bugs": {
    "url": "https://github.com/IgorWarzocha/howaboua-pi-stuff/issues"
  },
  "homepage": "https://github.com/IgorWarzocha/howaboua-pi-stuff/tree/main/packages/pi-unicode-charts#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "oxfmt": "0.79.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": ">=1.0.0"
  }
}
