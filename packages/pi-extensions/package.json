{
  "name": "@howaboua/pi-extensions",
  "version": "0.0.110",
  "description": "all Howaboua Pi extensions",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "howaboua"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@howaboua/pi-ask": "0.0.22",
    "@howaboua/pi-better-skills-tool": "0.0.15",
    "@howaboua/pi-cache-hit-predictor": "0.0.1",
    "@howaboua/pi-gippity-control": "0.0.34",
    "@howaboua/pi-github-watch": "0.0.9",
    "@howaboua/pi-gpt-switcher": "0.1.7",
    "@howaboua/pi-shepherdr": "1.0.4",
    "@howaboua/pi-suggestions": "0.0.4",
    "@howaboua/pi-unicode-charts": "0.1.6"
  },
  "files": [
    "README.md",
    "LICENSE",
    "index.ts",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
    "directory": "packages/pi-extensions"
  },
  "homepage": "https://github.com/IgorWarzocha/howaboua-pi-stuff/tree/main/packages/pi-extensions#readme",
  "bugs": {
    "url": "https://github.com/IgorWarzocha/howaboua-pi-stuff/issues"
  },
  "scripts": {
    "prepack": "bun run ../../scripts/prepare-aggregate-package.mjs",
    "format:check": "oxfmt --check '**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,css}'",
    "lint": "bun run format:check && oxlint --type-aware",
    "check": "bun run lint"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": ">=1.5.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0"
  }
}
