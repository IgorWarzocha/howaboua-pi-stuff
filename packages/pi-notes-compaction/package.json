{
	"name": "@howaboua/pi-notes-compaction",
	"version": "0.0.3",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
		"directory": "packages/pi-notes-compaction"
	},
	"files": [
		"src",
		"README.md",
		"PCC-INTEGRATION.md",
		"changelog.ts",
		"CHANGELOG.md"
	],
	"engines": {
		"node": ">=22.18.0"
	},
	"type": "module",
	"description": "Provider-neutral session notes and notes-guided context windows for Pi",
	"license": "MIT",
	"pi": {
		"extensions": [
			"./changelog.ts",
			"./src/index.ts"
		]
	},
	"main": "src/index.ts",
	"scripts": {
		"check": "bun run lint && bun run typecheck",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"better-sqlite3": "13.0.3"
	},
	"devDependencies": {
		"@types/better-sqlite3": "9.6.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.1.0",
		"@earendil-works/pi-agent-core": ">=1.0.4",
		"@earendil-works/pi-ai": ">=1.0.4",
		"@earendil-works/pi-tui": ">=1.0.4",
		"typebox": "*"
	}
}
