{
	"name": "@howaboua/pi-sites",
	"version": "0.0.0",
	"description": "ChatGPT Sites management for Pi, Code Mode and Notebook",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
		"directory": "packages/pi-sites"
	},
	"files": [
		"index.ts",
		"src",
		"README.md",
		"LICENSE",
		"tsconfig.json",
		"biome.json"
	],
	"main": "index.ts",
	"exports": "./index.ts",
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"check": "bun run lint && bun run typecheck",
		"lint": "biome check .",
		"typecheck": "tsgo --noEmit",
		"prepack": "bun run check",
		"pack:dry": "npm pack --dry-run"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.1.0",
		"typebox": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
