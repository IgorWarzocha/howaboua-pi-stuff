{
	"name": "@howaboua/pi-subagent-review",
	"version": "0.2.20",
	"description": "Pi extension that adds /review via an isolated review subagent.",
	"type": "module",
	"main": "index.ts",
	"exports": "./index.ts",
	"license": "MIT",
	"files": [
		"index.ts",
		"src",
		"review.prompt.md",
		"README.md",
		"tsconfig.json",
		"biome.json",
		"changelog.ts",
		"CHANGELOG.md"
	],
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"review",
		"code-review",
		"subagent",
		"agent"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
		"directory": "packages/pi-subagent-review"
	},
	"homepage": "https://github.com/IgorWarzocha/howaboua-pi-stuff/tree/main/packages/pi-subagent-review#readme",
	"bugs": {
		"url": "https://github.com/IgorWarzocha/howaboua-pi-stuff/issues"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@howaboua/pi-codex-conversion": ">=3.0.27",
		"@earendil-works/pi-ai": ">=0.84.3",
		"@earendil-works/pi-coding-agent": ">=0.84.3",
		"@earendil-works/pi-tui": ">=0.84.3"
	},
	"peerDependenciesMeta": {
		"@howaboua/pi-codex-conversion": {
			"optional": true
		}
	},
	"scripts": {
		"check": "bun run lint && bun run typecheck && bun run test",
		"prepack": "bun run check",
		"test": "bun test",
		"typecheck": "tsgo --noEmit",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"devDependencies": {
		"@howaboua/pi-codex-conversion": "3.0.27",
		"@earendil-works/pi-ai": "0.85.0",
		"@earendil-works/pi-coding-agent": "0.85.0",
		"@types/node": "^26.2.0",
		"typescript": "^7.0.2",
		"@biomejs/biome": "^2.5.10"
	},
	"publishConfig": {
		"access": "public"
	}
}
