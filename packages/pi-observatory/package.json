{
	"name": "@howaboua/pi-observatory",
	"version": "0.0.2",
	"type": "module",
	"license": "MIT",
	"description": "Local, SQLite-backed Pi session failure explorer",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
		"directory": "packages/pi-observatory"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"changelog.ts",
		"CHANGELOG.md"
	],
	"main": "dist/index.js",
	"bin": {
		"pi-observatory": "dist/src/server.js"
	},
	"pi": {
		"extensions": [
			"./changelog.ts",
			"./dist/index.js"
		]
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"start": "node dist/src/server.js",
		"check": "bun run lint && bun run typecheck",
		"lint": "biome check .",
		"typecheck": "tsgo --noEmit",
		"pack:dry": "npm pack --dry-run",
		"prepack": "bun run build"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"shell-quote": "1.12.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.3.0",
		"@earendil-works/pi-tui": ">=1.3.0"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0"
	}
}
