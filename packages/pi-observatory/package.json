{
	"name": "@howaboua/pi-observatory",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "Local, SQLite-backed Pi session failure explorer",
	"main": "index.ts",
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"start": "node src/server.ts",
		"check": "bun run lint && bun run typecheck",
		"lint": "biome check .",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.3.0"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0"
	}
}
