{
  "name": "@howaboua/pi-pulses",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Saved routines scheduled by a live main Pi session.",
  "main": "index.ts",
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": []
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck",
    "lint": "bun run format:check && oxlint --type-aware",
    "typecheck": "tsrs --noEmit",
    "format:check": "oxfmt --check '**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,css}'"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.3.0",
    "@howaboua/pi-codex-conversion": ">=5.1.0",
    "@howaboua/pi-shepherdr": "*"
  },
  "peerDependenciesMeta": {
    "@howaboua/pi-codex-conversion": {
      "optional": true
    },
    "@howaboua/pi-shepherdr": {
      "optional": true
    }
  },
  "dependencies": {
    "@earendil-works/pi-schema": "1.6.0"
  }
}
