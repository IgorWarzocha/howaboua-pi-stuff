{
  "name": "@howaboua/pi-chill",
  "private": true,
  "version": "0.0.0",
  "description": "Fold routine Pi tool activity while keeping conversation and errors visible.",
  "type": "module",
  "license": "MIT",
  "author": "Igor Warzocha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
    "directory": "packages/pi-chill"
  },
  "homepage": "https://github.com/IgorWarzocha/howaboua-pi-stuff/tree/main/packages/pi-chill#readme",
  "bugs": {
    "url": "https://github.com/IgorWarzocha/howaboua-pi-stuff/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "activity",
    "tui"
  ],
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "main": "index.ts",
  "exports": "./index.ts",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": ">=1.0.4"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "oxfmt": "0.79.0"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck",
    "lint": "bun run format:check && oxlint --type-aware",
    "format": "oxfmt --write '**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,css}'",
    "typecheck": "tsrs --noEmit",
    "pack:dry": "npm pack --dry-run",
    "prepack": "bun run check",
    "format:check": "oxfmt --check '**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,css}'"
  }
}
