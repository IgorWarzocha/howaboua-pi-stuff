{
  "name": "@howaboua/pi-stuff-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run scripts/workspaces.mjs check && bun run knip",
    "typecheck": "bun run scripts/workspaces.mjs typecheck",
    "test": "bun run scripts/workspaces.mjs test",
    "pack:dry": "bun run scripts/workspaces.mjs pack:dry",
    "changeset": "node scripts/add-patch-changeset.mjs",
    "changeset:raw": "changeset",
    "version-packages": "changeset version && bun run changelog:polish && bun run aggregate:sync && bun run changelog:extensions && bun run changelog:sync && bun install --lockfile-only --ignore-scripts",
    "release": "changeset publish",
    "check:changed": "bun run scripts/check-changed.mjs",
    "refactor:compare": "node scripts/refactor-compare.mjs",
    "browser-cdp:sync": "node scripts/sync-browser-cdp.mjs --write",
    "knip": "knip --workspace @howaboua/pi-ask --workspace @howaboua/pi-better-skills-tool --workspace @howaboua/pi-browser --workspace @howaboua/pi-codex-conversion --workspace @howaboua/pi-codex-imagegen --workspace @howaboua/pi-codex-web-run --workspace @howaboua/pi-gippity-control --workspace @howaboua/pi-auto-trees --workspace @howaboua/pi-pet --workspace @howaboua/pi-subagent-review --workspace @howaboua/pi-smart-btw --workspace @howaboua/pi-shepherdr --no-progress --include files,dependencies,unlisted,unresolved,cycles,exports,nsExports,types,nsTypes,enumMembers,namespaceMembers,duplicates",
    "changeset:aggregates": "bun run scripts/add-aggregate-changesets.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "changeset:check": "bun run scripts/require-changeset.mjs origin/main",
    "changelog:sync": "bun run scripts/sync-monorepo-changelog.mjs",
    "changelog:extensions": "bun run scripts/sync-extension-changelogs.mjs",
    "aggregate:sync": "bun run scripts/sync-aggregate-packages.mjs",
    "changelog:polish": "bun run scripts/polish-changelogs.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "^3.0.1",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-server": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "better-sqlite3": "^13.0.3",
    "c8": "^12.0.0",
    "knip": "^6.32.2",
    "node-pty": "^1.1.0",
    "openai": "^7.5.0",
    "oxfmt": "^0.64.0",
    "partial-json": "^0.1.7",
    "proxy-from-env": "2.1.0",
    "tree-sitter-bash": "^0.25.1",
    "tsx": "^4.23.12",
    "typebox": "1.3.18",
    "typescript": "^7.0.2",
    "web-tree-sitter": "^0.26.13"
  },
  "version": "0.0.1"
}
