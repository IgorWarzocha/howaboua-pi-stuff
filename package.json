{
  "name": "@howaboua/pi-stuff-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "install:ci": "bun install --frozen-lockfile --ignore-scripts && tsc -p scripts/tsconfig.browser-voice-start.json && bun install --frozen-lockfile --force && bun run --cwd packages/pi-browser build",
    "check": "bun run lint:root && bun run scripts/workspaces.mjs check && bun run knip",
    "typecheck": "bun run scripts/workspaces.mjs typecheck",
    "test": "bun run scripts/workspaces.mjs test",
    "pack:dry": "bun run scripts/workspaces.mjs pack:dry",
    "changeset": "node scripts/add-patch-changeset.mjs",
    "changeset:raw": "changeset",
    "version-packages": "bun run changeset:aggregates && changeset version && bun run changelog:polish && bun run aggregate:sync && bun run changelog:sync && bun install --lockfile-only --ignore-scripts",
    "release": "node scripts/preflight-release.mjs && changeset publish",
    "check:changed": "bun run scripts/check-changed.mjs",
    "refactor:compare": "node scripts/refactor-compare.mjs",
    "pi:link-checkout": "node scripts/link-pi-checkout.mjs",
    "sandbox:setup": "node scripts/setup-repo-sandbox.mjs",
    "browser-cdp:sync": "node scripts/sync-browser-cdp.mjs --write",
    "knip": "knip --workspace @howaboua/pi-suggestions --workspace @howaboua/pi-observatory --workspace @howaboua/pi-agent-comms --workspace @howaboua/pi-grok-realtime --workspace @howaboua/pi-chatgpt-sites --workspace @howaboua/pi-ask --workspace @howaboua/pi-better-skills-tool --workspace @howaboua/pi-browser --workspace @howaboua/pi-chill --workspace @howaboua/pi-sandbox --workspace @howaboua/pi-codex-conversion --workspace @howaboua/pi-codex-guardian --workspace @howaboua/pi-codex-imagegen --workspace @howaboua/pi-codex-web-run --workspace @howaboua/pi-gippity-control --workspace @howaboua/pi-github-watch --workspace @howaboua/pi-pet --workspace @howaboua/pi-pulses --workspace @howaboua/pi-shepherdr --no-progress --include files,dependencies,unlisted,unresolved,cycles,exports,nsExports,types,nsTypes,enumMembers,namespaceMembers,duplicates",
    "changeset:aggregates": "bun run scripts/add-aggregate-changesets.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "changeset:check": "bun run scripts/require-changeset.mjs origin/main",
    "changelog:sync": "bun run scripts/sync-monorepo-changelog.mjs",
    "aggregate:sync": "bun run scripts/sync-aggregate-packages.mjs",
    "changelog:polish": "bun run scripts/polish-changelogs.mjs",
    "format:check": "oxfmt --check '**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,css}'",
    "format": "oxfmt --write '**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,css}'",
    "format:check:root": "oxfmt --check '**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,css}' '!packages/**'",
    "lint": "bun run lint:root && bun run scripts/workspaces.mjs lint",
    "lint:root": "bun run format:check:root && oxlint --type-aware . --ignore-pattern 'packages/**'"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@earendil-works/pi-agent-core": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-schema": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "aria-query": "5.3.2",
    "better-sqlite3": "13.2.0",
    "c8": "12.0.0",
    "html-validate": "11.4.0",
    "knip": "6.48.0",
    "node-pty": "1.1.0",
    "openai": "7.62.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "partial-json": "0.1.7",
    "proxy-from-env": "2.1.0",
    "stylelint": "17.16.0",
    "tsrs": "7.1.0-beta.tsrs4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "web-tree-sitter": "0.27.2"
  },
  "version": "0.0.1"
}
