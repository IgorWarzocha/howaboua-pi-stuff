{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		"packages/pi-auto-trees": {
			"entry": ["changelog.ts"]
		},
		"packages/pi-codex-conversion": {
			"ignoreExportsUsedInFile": true,
			"entry": [
				"src/index.ts",
				"src/code-mode-preflight.ts",
				"src/realtime-voice.ts",
				"scripts/**/*.mjs",
				"examples/custom-tools/**/*.mjs",
				"tests/**/*.test.ts",
				"changelog.ts"
			],
			"project": [
				"src/**/*.ts",
				"scripts/**/*.mjs",
				"examples/custom-tools/**/*.mjs",
			"tests/**/*.ts"
			],
			"ignoreDependencies": ["proxy-from-env"]
		},
		"packages/pi-gippity-control": {
			"entry": ["changelog.ts"]
		},
		"packages/pi-shepherdr": {
			"entry": ["changelog.ts"]
		},
		"packages/pi-smart-btw": {
			"entry": ["changelog.ts"]
		},
		"packages/pi-subagent-review": {
			"entry": ["changelog.ts", "tests/**/*.test.ts"],
			"project": ["src/**/*.ts", "tests/**/*.ts"]
		}
	}
}
